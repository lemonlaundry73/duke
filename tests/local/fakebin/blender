        res['ok'] = False; res['error'] = 'Traceback (most recent call last):\nRuntimeError: boom'
    else:
        objs += [{'name': n, 'type': 'MESH', 'location': [0, 0, 0], 'dimensions': [1, 1, 1]} for n in re.findall(r'\.name="(\w+)"', code)]
