PORT=3000
# Public URL (canonical links, Stripe redirects, agent setup). Example: https://dukeforge.com
SITE_URL=
# Where accounts, projects, uploads and builds are stored (a persistent disk in production)
DATA_DIR=
# Comma-separated emails that get full Studio access (site owners)
ADMIN_EMAILS=

# AI director (Claude preferred)
ANTHROPIC_API_KEY=
DUKE_CLAUDE_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_REASONING_MODEL=gpt-5.3-codex

# Meshy: concept art, image-to-3D, auto-rigging, animation
MESHY_API_KEY=
MESHY_IMAGE_MODEL=nano-banana-pro
MESHY_3D_MODEL=latest

# Stripe subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR_MONTH=
STRIPE_PRICE_CREATOR_YEAR=
STRIPE_PRICE_ACADEMY_MONTH=
STRIPE_PRICE_ACADEMY_YEAR=
STRIPE_PRICE_STUDIO_MONTH=
STRIPE_PRICE_STUDIO_YEAR=
# Local testing without Stripe: plans activate instantly. Never enable on a public server.
BILLING_TEST_MODE=

# Shared Windows cloud build server for Studio (run the agent there with this token)
CLOUD_AGENT_TOKEN=
